# Environment Variables for Voice Shopping Assistant

# 1. Groq API Key (Free tier - for System 2 Conscious LLM parsing)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# 2. Hugging Face Access Token (Free tier - for Whisper Large V3 careful audio transcription)
# Get your free token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=

# 3. CORS Allowed Origins (comma-separated, defaults to * for local development)
CORS_ORIGINS=*

# 4. SQLite Database Path (defaults to sqlite:///./shopping_assistant.db)
DATABASE_URL=sqlite:///./shopping_assistant.db
